# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Flask Secret Key
SECRET_KEY=your_secret_key_here

# Database Configuration (PostgreSQL or SQLite)
# PostgreSQL example: postgresql+psycopg://postgres:password@localhost:5432/adaptive_learning2_db
# SQLite example: sqlite:///../data/database.db
DATABASE_URL=postgresql+psycopg://postgres:admin123@localhost:5432/adaptive_learning2_db

# Flask Environment
FLASK_ENV=development

# Optional SendGrid Configuration (for email verification)
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@yourdomain.com